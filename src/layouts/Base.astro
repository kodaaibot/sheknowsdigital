---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '../styles/global.css';
import { SITE, NAV } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Menu items for this page. Defaults to the site menu. */
  nav?: { href: string; label: string }[];
  /** Highlights Field Notes in the menu on posts and category pages. */
  isPost?: boolean;
  schema?: object[];
}
const { title, description, ogImage = SITE.defaultOgImage, ogType = 'website', noindex = false, nav = NAV, isPost = false, schema = [] } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(path, SITE.url).href;
// Each page passes its own nodes. The homepage carries the full Organization, Person and WebSite (see src/lib/schema.ts).
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    ...schema,
  ],
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow, noarchive' : 'max-image-preview:large'} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="She Knows Digital" href="/rss.xml" />
    {schema.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="inner">
        <a class="logo" href="/">she<span>knows</span>digital</a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path === n.href || (n.href === '/blog/' && isPost) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="pill" href="/contact/">Book a call</a>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="inner">
        <div class="brand">
          <a class="logo" href="/">she<span>knows</span>digital</a>
          <p class="blurb">Senior eCommerce SEO consulting by Mags Sikora. Written between hikes, with a cat on the keyboard.</p>
          <a class="footer-cta" href="/contact/">Book a call</a>
        </div>
        <nav class="cols" aria-label="Footer">
          <div>
            <h2>Explore</h2>
            <ul>
              {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Resources</h2>
            <ul>
              <li><a href="/seo-checklist-blog-post-writing/">SEO Checklist</a></li>
              <li><a href="/seo-ebook/">SEO eBook</a></li>
              <li><a href="/contact/">Contact</a></li>
            </ul>
          </div>
          <div>
            <h2>Elsewhere</h2>
            <ul>
              <li><a href="https://www.linkedin.com/in/magdalenasikora/" rel="noopener me">LinkedIn</a></li>
              <li><a href="https://www.youtube.com/c/Sheknowsdigital" rel="noopener me">YouTube</a></li>
              <li><a href="https://www.magstags.com/" rel="noopener me">MagsTags</a></li>
            </ul>
          </div>
        </nav>
      </div>
      <div class="base">
        <p>© {new Date().getFullYear()} sheknowsdigital. Grown organically.</p>
        <ul>
          <li><a href="/terms-and-conditions/">Terms &amp; Conditions</a></li>
          <li><a href="/disclaimer/">Disclaimer</a></li>
          <li><a href="/cookie-policy/">Cookie Policy</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
