---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '../styles/global.css';
import { SITE, NAV } from '../lib/site';
import { webPage, breadcrumb, type Crumb } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Menu items for this page. Defaults to the site menu. */
  nav?: { href: string; label: string }[];
  /** Highlights Field Notes in the menu on posts and category pages. */
  isPost?: boolean;
  /** Extra JSON-LD nodes for this page. */
  schema?: object[];
  /** This page's name in the breadcrumb. Required for JSON-LD on every page except the homepage. */
  crumb?: string;
  /** Breadcrumb levels between Home and this page. */
  trail?: Crumb[];
  /** Extra properties for the WebPage node, including a more specific @type. */
  page?: Record<string, unknown>;
}
const { title, description, ogImage = SITE.defaultOgImage, ogType = 'website', noindex = false, nav = NAV, isPost = false, schema = [], crumb, trail = [], page = {} } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(path, SITE.url).href;
// Every indexable page gets a WebPage node and (except the homepage) a BreadcrumbList, plus whatever nodes the page adds.
// See src/lib/schema.ts. Pages without a crumb name (the 404) carry no JSON-LD.
const nodes = crumb || path === '/'
  ? [
      webPage(path, title, description, page),
      ...(path === '/' ? [] : [breadcrumb(path, crumb!, trail)]),
      ...schema,
    ]
  : [];
const graph = { '@context': 'https://schema.org', '@graph': nodes };
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow, noarchive' : 'max-image-preview:large'} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#24452f" />
    <link rel="alternate" type="application/rss+xml" title="She Knows Digital" href="/rss.xml" />
    {nodes.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="inner">
        <a class="logo" href="/">she<span>knows</span>digital</a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path === n.href || (n.href === '/blog/' && isPost) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="pill" href="/contact/">Discuss your project</a>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="inner">
        <div class="brand">
          <a class="logo" href="/">she<span>knows</span>digital</a>
          <p class="blurb">Senior eCommerce SEO consulting by Mags Sikora. Written between hikes, with a cat on the keyboard.</p>
          <a class="footer-cta" href="/contact/">Discuss your project</a>
        </div>
        <nav class="cols" aria-label="Footer">
          <div>
            <h2>Explore</h2>
            <ul>
              {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Resources</h2>
            <ul>
              <li><a href="/seo-checklist-blog-post-writing/">SEO Checklist</a></li>
              <li><a href="/contact/">Contact</a></li>
            </ul>
          </div>
          <div>
            <h2>Elsewhere</h2>
            <ul>
              <li><a href="https://www.linkedin.com/in/magdalenasikora/" rel="noopener me">LinkedIn</a></li>
              <li><a href="https://www.youtube.com/c/Sheknowsdigital" rel="noopener me">YouTube</a></li>
              <li><a href="https://www.magstags.com/" rel="noopener me">MagsTags</a></li>
            </ul>
          </div>
        </nav>
      </div>
      <div class="base">
        <p>© {new Date().getFullYear()} sheknowsdigital. Grown organically.</p>
        <ul>
          <li><a href="/terms-and-conditions/">Terms &amp; Conditions</a></li>
          <li><a href="/disclaimer/">Disclaimer</a></li>
          <li><a href="/cookie-policy/">Cookie Policy</a></li>
          <li><button type="button" class="linklike" data-cookie-settings>Cookie settings</button></li>
        </ul>
      </div>
    </footer>
    <script is:inline>
      // Cookie consent loads only after the page has fully loaded, in idle time, so it never delays rendering.
      // Clicks on "Cookie settings" or "Allow embedded content" before then load it straight away.
      (function () {
        var s;
        function load(intent) {
          if (window.skdConsent) { if (intent) window.skdConsent[intent](); return; }
          if (s) { if (intent) s.setAttribute('data-intent', intent); return; }
          s = document.createElement('script');
          s.src = '/consent.js';
          s.async = true;
          if (intent) s.setAttribute('data-intent', intent);
          document.body.appendChild(s);
        }
        function idle() { (window.requestIdleCallback || function (f) { setTimeout(f, 1); })(function () { load(); }); }
        if (document.readyState === 'complete') idle(); else window.addEventListener('load', idle);
        document.addEventListener('click', function (e) {
          var t = e.target.closest && e.target.closest('[data-cookie-settings],[data-consent-load]');
          if (!t || window.skdConsent) return;
          e.preventDefault();
          load(t.hasAttribute('data-consent-load') ? 'allowEmbeds' : 'open');
        });
      })();
    </script>
  </body>
</html>
