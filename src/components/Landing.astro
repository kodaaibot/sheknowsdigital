---
// Shared layout for the two lead magnet pages (SEO checklist and SEO ebook).
import SubscribeForm from './SubscribeForm.astro';
interface Props { heading: string; lead: string; formName: string; button: string; cover: string; coverAlt: string; photo: string; closingCta: string; strict?: boolean }
const { heading, lead, formName, button, cover, coverAlt, photo, closingCta, strict = false } = Astro.props;
const U = '/wp-content/uploads';
const brands = [['logo-expedia-300x183-1.webp', 'Expedia'], ['logo-hotels-300x183-1.webp', 'Hotels.com'], ['logo-newlook-300x183-1.webp', 'New Look'], ['logo-bookatable-300x183-1.webp', 'Bookatable'], ['logo-cooler-300x183-1.webp', 'Cooler'], ['rideuk-bmx-300x183-1.webp', 'Ride UK BMX']];
---
<section class="landing-hero" style="margin-top:28px">
  <div class="wrap split">
    <div>
      <h1>{heading}</h1>
      <p class="lead">{lead}</p>
      <SubscribeForm name={formName} button={button} consentRequired={strict} nameRequired={strict} />
    </div>
    <img class="cover" src={U + cover} alt={coverAlt} />
  </div>
</section>
<section class="wrap split section intro">
  <div>
    <slot name="intro" />
  </div>
  <img src={U + photo} alt="Mags Sikora, ecommerce SEO specialist, London" loading="lazy" />
</section>
<section class="wrap">
  <h2 class="subhead">Some of the brands I've worked with</h2>
  <div class="logos band-sand" style="padding:8px 24px">
    {brands.map(([f, alt]) => <img src={U + '/2021/12/' + f} alt={alt} loading="lazy" style="max-height:92px" />)}
  </div>
</section>
<p class="stat">61% of users start an online search from the search engine. 95% of them will never go to the 2nd Google page. Fact.</p>
<section class="wrap split">
  <img src={U + '/2022/02/mags-sikora-writing-an-ebook.webp'} alt="Mags Sikora writing on a laptop" loading="lazy" />
  <div>
    <p class="eyebrow">Imagine that</p>
    <h2 style="font-size:clamp(26px,3.4vw,36px)"><slot name="imagine" /></h2>
    <ul>
      <li>You have a clear process in mind to make your blog post Google friendly!</li>
      <li>You increase chances to rank your posts higher in Google! The higher your posts rank for relevant terms, the more targetted traffic you get and the more leads it generates!</li>
      <li>You understand better how Google sees your posts.</li>
      <li>The saved time, you can spend on other revenue-generating activities</li>
    </ul>
  </div>
</section>
<section class="closing">
  <p>Give Google <span>a good reason</span> to rank you on their 1st page!</p>
  <a class="btn" href="#subscribe">{closingCta}</a>
</section>
