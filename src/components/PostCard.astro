---
import { CATEGORIES, formatDate } from '../lib/site';
interface Props { post: any; heading?: 'h2' | 'h3' }
const { post, heading: H = 'h2' } = Astro.props;
const d = post.data;
const cat = d.categories[0];
---
<article class="note-card">
  <p class="kicker">{cat ? (CATEGORIES[cat] ?? cat) + ' · ' : ''}<time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></p>
  <H><a href={`/${post.id}/`}>{d.title}</a></H>
  {d.excerpt && <p>{d.excerpt}</p>}
</article>
