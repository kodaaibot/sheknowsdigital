---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/site';
import meta from '../data/page-meta.json';
const posts = await getPosts();
const m = meta['/blog/'];
---
<Base title={m.title} description={m.description}>
  <section class="section">
    <div class="section-head">
      <h1 class="display">Your SEO Resources</h1>
      <p>Practical SEO guides for bloggers, solopreneurs and site owners.</p>
    </div>
    <div class="cards">{posts.map((post) => <PostCard post={post} />)}</div>
  </section>
</Base>
