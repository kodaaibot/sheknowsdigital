---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Filters from '../components/Filters.astro';
import { getPosts } from '../lib/site';
const posts = await getPosts();
---
<Base title="Field Notes — SEO Thought Leadership | sheknowsdigital" description="Articles on enterprise eCommerce SEO, migrations, AI search and information architecture by Mags Sikora.">
  <section class="intro-head">
    <p class="kicker">Field notes</p>
    <h1>Notes from the trail and the garden.</h1>
  </section>
  <div class="w-6xl">
    <Filters />
    <div class="grid-2 notes">{posts.map((post) => <PostCard post={post} />)}</div>
  </div>
</Base>
