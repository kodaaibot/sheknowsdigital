---
// Homepage, rebuilt like for like from the Lovable sheknowsdigital design.
import Base from '../layouts/Base.astro';
import { SERVICES as services } from '../lib/site';

const notes = [
  ['Expeditions', '8 min read', 'Why every replatform is a mountain expedition', 'Acclimatise, pack redundancy, and never summit on a Friday. Lessons from a decade of enterprise migrations.'],
  ['Cultivation', '6 min read', 'Deep roots: organic search as compounding cultivation', 'Growth hacks are annuals. Information architecture is a perennial. On planting for the next five seasons.'],
  ['Weather', '10 min read', 'Navigating AI Overviews without losing the trail', 'How eCommerce brands can stay visible as the results page reshapes itself under generative answers.'],
];
// Logos already used on the WordPress site.
const brands = [['exp-logo', 'Expedia'], ['nl-logo-2', 'New Look'], ['eh-logo', 'Emirates Holidays'], ['htls-logo', 'Hotels.com'], ['tr-logo', 'Travel Republic'], ['nf-logo', 'Netflights']];
const arrow = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>';
const sprout = '<path d="M14 9.536V7a4 4 0 0 1 4-4h1.5a.5.5 0 0 1 .5.5V5a4 4 0 0 1-4 4 4 4 0 0 0-4 4c0 2 1 3 1 5a5 5 0 0 1-1 3"></path><path d="M4 9a5 5 0 0 1 8 4 5 5 0 0 1-8-4"></path><path d="M5 21h14"></path>';
---
<Base title="Mags Sikora — Senior eCommerce SEO Consultant | sheknowsdigital" description="18+ years of enterprise eCommerce SEO for Expedia, New Look, Emirates Group and Hotels.com. Technical audits, migrations, AI & full-SERP strategy.">
  <div class="he">
    <section class="cover">
      <div class="cover-inner">
        <p class="label muted">Independent consultant · 18+ years in enterprise SEO</p>
        <h1 class="title">Mags Sikora<span class="clay">.</span></h1>
        <p class="subtitle">Senior eCommerce SEO consultant</p>
        <div class="cover-bottom">
          <div>
            <p class="cover-copy">Clear direction for complex websites. Technical audits, migrations and organic growth—with senior expertise at every step.</p>
            <div class="actions">
              <a class="solid" href="/contact/">Let’s talk <Fragment set:html={arrow} /></a>
              <a class="link" href="/services/">Explore services <Fragment set:html={arrow} /></a>
            </div>
          </div>
          <div class="signature">
            <img src="/images/home/mags-sikora-illustrated.jpg" alt="Illustrated portrait of Mags Sikora" width="88" height="88" fetchpriority="high" />
            <div>
              <p class="note">A head for search.<br />A heart for the outdoors.</p>
              <a class="link small" href="/about/">Meet Mags <Fragment set:html={arrow} /></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="proof">
      <div class="container proof-inner">
        <p class="label muted">Experience with</p>
        <div class="brands">{brands.map(([file, name]) => <img src={`/wp-content/uploads/2022/02/${file}.webp`} alt={name} width="260" height="150" loading="lazy" />)}</div>
      </div>
    </section>

    <section class="container section intro">
      <div>
        <p class="label clay">01 / Perspective</p>
        <p class="margin-note">Less noise.<br />More substance.</p>
      </div>
      <div>
        <h2 class="heading">Big-picture thinking.<br /><em class="clay">Ground-level care.</em></h2>
        <p class="lede">Enterprise search is rarely a straight path. I bring senior judgement to the technical details, and work alongside your team to turn a clear strategy into lasting organic growth.</p>
        <div class="principles">
          <div>
            <svg class="icon green" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 3 4 8 5-5 5 15H2L8 3z"></path></svg>
            <h3>Plan the climb.</h3>
            <p>Map the risks before a migration. Give engineering a prioritised route, and stay close through launch.</p>
          </div>
          <div>
            <svg class="icon clay" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={sprout} />
            <h3>Tend the roots.</h3>
            <p>Build sound architecture, useful content and clean technical foundations. Growth that has something to stand on.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="services" id="services">
      <div class="container section services-layout">
        <div>
          <p class="label clay">02 / Expertise</p>
          <h2 class="heading mt20">Where I<br />can help<span class="clay">.</span></h2>
          <p class="aside">Focused engagements. Senior support.<br />A practical way forward.</p>
          <a class="link mt20" href="/services/">All services <Fragment set:html={arrow} /></a>
        </div>
        <div>
          {services.map(([name, tag, text], i) => (
            <details class="service" name="service" open={i === 0}>
              <summary>
                <span class="number">0{i + 1}</span>
                <span class="name">{name}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path><path class="v" d="M12 5v14"></path></svg>
              </summary>
              <div class="service-body">
                <p class="tag">{tag}</p>
                <p class="text">{text}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="container check">
      <div class="check-copy">
        <svg class="clay" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={sprout} />
        <div>
          <p class="label muted">A good place to start</p>
          <h2>How healthy are your foundations?</h2>
        </div>
      </div>
      <a class="outline" href="/audit/">SEO health check <Fragment set:html={arrow} /></a>
    </section>

    <section class="container section">
      <div class="notes-head">
        <div>
          <p class="label clay">03 / Field notes</p>
          <h2 class="heading mt20">Worth a closer look.</h2>
        </div>
        <a class="link" href="/blog/">All field notes <Fragment set:html={arrow} /></a>
      </div>
      <div class="articles">
        {notes.map(([cat, time, title, text]) => (
          <article>
            <div class="meta"><span class="clay">{cat}</span><span class="muted">{time}</span></div>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="personal">
      <div class="container section personal-layout">
        <figure>
          <img src="/images/home/mags-sikora-about.webp" alt="Portrait of Mags Sikora" width="640" height="640" loading="lazy" />
          <figcaption>The person behind the perspective.</figcaption>
        </figure>
        <div>
          <p class="label clay">04 / A little off the beaten path</p>
          <h2 class="heading mt20">Not all my interests<br />are <em class="clay">search-related.</em></h2>
          <p class="lede narrow">Mountain trails, a growing garden, and cats. Away from the screen, I’m happiest exploring or tending something. The curiosity comes back to work with me.</p>
          <a class="link mt20" href="/about/">More about Mags <Fragment set:html={arrow} /></a>
          <p class="cat-note">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="4" r="2"></circle><circle cx="18" cy="8" r="2"></circle><circle cx="20" cy="16" r="2"></circle><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"></path></svg>
            Occasionally supervised by a cat.
          </p>
        </div>
      </div>
    </section>

    <div class="container press">
      <p class="label muted">In print &amp; on stage</p>
      <div><span>eConsultancy</span><span>Marie Claire</span><span>ClickZ</span><span>SEMCamp</span></div>
    </div>
  </div>
</Base>

<style>
  .he { font: 400 16px/1.5 var(--sans); color: var(--fg); }
  .he h1, .he h2, .he h3 { font-family: var(--display); font-weight: 400; margin: 0; }
  .he p, .he figure { margin: 0; }
  .he :global(svg) { flex-shrink: 0; }
  .clay { color: var(--clay); }
  .muted { color: var(--muted); }
  .mt20 { margin-top: 20px !important; }
  .container { max-width: 1152px; margin-inline: auto; padding-inline: 32px; }
  .section { padding-block: 88px; }
  .label { font-size: 11px; font-weight: 600; line-height: 1.6; }
  .heading { font-size: 44px; line-height: 1.16; }
  .heading em { font-style: italic; }
  .lede { margin-top: 24px !important; max-width: 42rem; line-height: 1.625; color: var(--muted); }
  .lede.narrow { max-width: 32rem; }

  .link, .solid, .outline { display: inline-flex; align-items: center; justify-content: center; gap: 8px; white-space: nowrap; font-size: 14px; font-weight: 500; line-height: 20px; }
  .link { height: 36px; color: var(--primary); text-underline-offset: 4px; }
  .link:hover { text-decoration: underline; }
  .link.small { height: auto; padding-top: 8px; font-size: 12px; }
  .link.small :global(svg) { width: 13px; height: 13px; }
  .solid { height: 48px; padding: 0 24px; background: var(--primary); color: var(--on-primary); box-shadow: 0 1px 3px rgba(0, 0, 0, .1), 0 1px 2px -1px rgba(0, 0, 0, .1); }
  .solid:hover { text-decoration: none; opacity: .9; }
  .outline { height: 48px; padding: 0 32px; border: 1px solid var(--border); background: var(--bg); color: var(--fg); box-shadow: 0 1px 2px rgba(0, 0, 0, .05); }
  .outline:hover { text-decoration: none; background: var(--clay); color: oklch(98% 0.01 85); }

  .cover-inner { max-width: 1152px; margin-inline: auto; padding: 64px 32px 56px; }
  .title { color: var(--primary); margin-top: 24px !important; font-size: 112px; line-height: 1.05; }
  .subtitle { font-family: var(--display); color: var(--muted); margin-top: 12px !important; font-size: 32px; font-style: italic; }
  .cover-bottom { border-top: 1px solid var(--border); display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: center; gap: 64px; margin-top: 40px; padding-top: 32px; }
  .cover-copy { max-width: 480px; color: var(--muted); line-height: 1.8; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 28px; margin-top: 24px; }
  .signature { border-left: 1px solid var(--border); display: flex; align-items: center; gap: 20px; padding-left: 32px; }
  .signature img { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .note { font-family: var(--display); font-size: 18px; font-style: italic; line-height: 1.5; }

  .proof { background: var(--secondary); border-bottom: 1px solid var(--border); }
  .proof-inner { display: grid; grid-template-columns: 150px 1fr; align-items: center; gap: 20px; padding-block: 26px; }
  .brands { display: flex; justify-content: space-between; align-items: center; gap: 24px; background: none; border: 0; border-radius: 0; overflow: visible; }
  .brands img { width: auto; height: 80px; min-width: 0; mix-blend-mode: multiply; filter: grayscale(1); opacity: .85; }

  .intro, .services-layout { display: grid; grid-template-columns: 1fr 2fr; gap: 64px; }
  .margin-note { font-family: var(--display); color: var(--muted); margin-top: 32px !important; font-size: 19px; font-style: italic; }
  .principles { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 40px; }
  .principles .icon { width: 24px; height: 24px; margin-bottom: 16px; display: block; }
  .principles .green { color: var(--primary); }
  .principles h3 { font-size: 24px; line-height: 32px; }
  .principles p { margin-top: 12px; font-size: 14px; line-height: 1.625; color: var(--muted); }

  .services { background: var(--card); border-block: 1px solid var(--border); scroll-margin-top: 70px; }
  .aside { margin-top: 20px !important; max-width: 20rem; font-size: 14px; line-height: 1.625; color: var(--muted); }
  .service { border-top: 1px solid var(--border); }
  .service:last-child { border-bottom: 1px solid var(--border); }
  .service summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 30px 1fr 20px; align-items: center; gap: 18px; min-height: 80px; padding: 20px 0; }
  .service summary::-webkit-details-marker { display: none; }
  .service summary:hover { color: var(--clay); }
  .service[open] summary .v { display: none; }
  .number { color: var(--clay); font-size: 11px; font-weight: 500; }
  .name { font-family: var(--display); font-size: 25px; line-height: 1.3; }
  .service-body { padding: 0 38px 28px 48px; }
  .tag { font-family: var(--display); font-size: 18px; line-height: 28px; font-style: italic; color: var(--clay); }
  .text { margin-top: 12px !important; font-size: 14px; line-height: 1.625; color: var(--muted); }

  .check { display: flex; justify-content: space-between; align-items: center; gap: 32px; padding-block: 44px; border-bottom: 1px solid var(--border); }
  .check-copy { display: flex; align-items: flex-start; gap: 20px; }
  .check-copy > :global(svg) { margin-top: 4px; }
  .check h2 { margin-top: 8px; font-size: 30px; line-height: 36px; }

  .notes-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; }
  .articles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; margin-top: 40px; }
  .articles article { border-top: 1px solid var(--border); padding-top: 20px; }
  .articles .meta { display: flex; align-items: center; justify-content: space-between; font-size: 12px; line-height: 16px; }
  .articles h3 { margin-top: 24px; font-size: 24px; line-height: 1.375; }
  .articles p { margin-top: 16px; font-size: 14px; line-height: 1.625; color: var(--muted); }

  .personal { background: var(--secondary); border-block: 1px solid var(--border); }
  .personal-layout { display: grid; grid-template-columns: 300px 1fr; align-items: center; gap: 100px; }
  .personal figure { max-width: 300px; }
  .personal img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
  .personal figcaption { margin-top: 12px; font-family: var(--display); font-size: 14px; line-height: 20px; font-style: italic; color: var(--muted); }
  .cat-note { font-family: var(--display); color: var(--muted); display: flex; align-items: center; gap: 9px; margin-top: 28px !important; font-size: 14px; font-style: italic; }

  .press { display: flex; align-items: center; gap: 56px; padding-block: 34px; }
  .press div { display: flex; flex-wrap: wrap; gap: 12px 32px; font-size: 14px; line-height: 20px; color: var(--muted); }

  @media (max-width: 767px) {
    .container { padding-inline: 24px; }
    .section { padding-block: 56px; }
    .cover-inner { padding: 36px 24px 32px; }
    .title { font-size: 50px; }
    .subtitle { font-size: 22px; }
    .cover-bottom { grid-template-columns: 1fr; gap: 24px; margin-top: 24px; padding-top: 24px; }
    .cover-copy { font-size: 14px; }
    .actions { gap: 20px; margin-top: 20px; }
    .signature { border-left: 0; border-top: 1px solid var(--border); gap: 16px; padding: 20px 0 0; }
    .signature img { width: 64px; height: 64px; }
    .note { font-size: 15px; }
    .proof-inner { grid-template-columns: 1fr; gap: 16px; padding-block: 26px; }
    .brands { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; justify-items: center; background: none; }
    .brands img { height: 60px; }
    .intro, .services-layout { grid-template-columns: 1fr; gap: 28px; }
    .margin-note { display: none; }
    .heading { font-size: 34px; }
    .principles { gap: 24px; }
    .name { font-size: 22px; }
    .service summary { grid-template-columns: 24px 1fr 20px; gap: 12px; min-height: 76px; }
    .service-body { padding-left: 36px; padding-right: 12px; }
    .check { flex-direction: column; align-items: flex-start; gap: 24px; padding-block: 36px; }
    .check h2 { font-size: 25px; }
    .articles { grid-template-columns: 1fr; gap: 32px; }
    .personal-layout { grid-template-columns: 1fr; gap: 36px; }
    .personal figure { max-width: 250px; }
    .press { flex-direction: column; align-items: flex-start; gap: 16px; }
  }
  @media (max-width: 359px) {
    .title { font-size: 42px; }
    .subtitle { font-size: 19px; }
    .actions { gap: 12px; }
    .solid { padding-inline: 16px; }
  }
</style>
