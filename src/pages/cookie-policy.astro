---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import meta from '../data/page-meta.json';
const m = meta['/cookie-policy/'];
const entry = await getEntry('legal', 'cookie-policy');
const { Content } = await render(entry!);
---
<Base title={m.title} crumb="Cookie Policy">
  <div class="post-body">
    <div class="narrow prose legal">
      <Content />
      <p><button type="button" class="btn" data-cookie-settings>Change cookie settings</button></p>
    </div>
  </div>
</Base>
