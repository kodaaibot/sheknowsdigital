---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, SITE, CATEGORIES, formatDate } from '../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Previous = older post, next = newer post, as on the WordPress site.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, next: posts[i - 1], prev: posts[i + 1], more: posts.filter((p) => p.id !== post.id).slice(0, 2) },
  }));
}
const { post, prev, next, more } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const url = `${SITE.url}/${post.id}/`;
const share = encodeURIComponent(url);
const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#blogposting`,
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    dateModified: (d.modified ?? d.date).toISOString(),
    inLanguage: 'en-GB',
    mainEntityOfPage: url,
    ...(d.featuredImage ? { image: SITE.url + d.featuredImage } : {}),
    articleSection: d.categories.map((c) => CATEGORIES[c] ?? c).join(', '),
    author: { '@type': 'Person', name: SITE.author, url: `${SITE.url}/about/` },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: d.title, item: url },
    ],
  },
];
---
<Base title={d.titleTag ?? `${d.title} - ${SITE.name}`} description={d.description} ogImage={d.ogImage} ogType="article" schema={schema} isPost>
  <article>
    <header class="intro-head">
      <p class="kicker">{d.categories.map((c, i) => <>{i > 0 && ', '}<a href={`/category/${c}/`}>{CATEGORIES[c] ?? c}</a></>)}{d.categories.length > 0 && ' · '}<time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></p>
      <h1>{d.title}</h1>
    </header>
    <div class="w-4xl">
      <div class="prose" style="max-width:720px"><Content /></div>
      <div class="post-meta" style="max-width:720px">
        <span>{SITE.author}</span>
        <ul class="share" aria-label="Share this post">
          <li><a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} rel="noopener nofollow" target="_blank">Facebook</a></li>
          <li><a href={`https://twitter.com/intent/tweet?url=${share}&text=${encodeURIComponent(d.title)}`} rel="noopener nofollow" target="_blank">Twitter</a></li>
          <li><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${share}`} rel="noopener nofollow" target="_blank">LinkedIn</a></li>
        </ul>
      </div>
    </div>
  </article>
  <nav class="w-4xl post-nav" aria-label="Posts">
    {prev && <a href={`/${prev.id}/`} rel="prev">← {prev.data.title}</a>}
    {next && <a href={`/${next.id}/`} rel="next">{next.data.title} →</a>}
  </nav>
  <section class="w-6xl" style="margin-top:72px">
    <h2 style="font-size:30px;line-height:36px;margin:0 0 24px">More field notes</h2>
    <div class="grid-2">{more.map((p) => <PostCard post={p} heading="h3" />)}</div>
  </section>
</Base>
