---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, SITE, CATEGORIES, formatDate } from '../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Previous = older post, next = newer post, as on the WordPress site.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, next: posts[i - 1], prev: posts[i + 1], more: posts.filter((p) => p.id !== post.id).slice(0, 4) },
  }));
}
const { post, prev, next, more } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const url = `${SITE.url}/${post.id}/`;
const share = encodeURIComponent(url);
const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#blogposting`,
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    dateModified: (d.modified ?? d.date).toISOString(),
    inLanguage: 'en-GB',
    mainEntityOfPage: url,
    ...(d.featuredImage ? { image: SITE.url + d.featuredImage } : {}),
    articleSection: d.categories.map((c) => CATEGORIES[c] ?? c).join(', '),
    author: { '@type': 'Person', name: SITE.author, url: `${SITE.url}/about/` },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: d.title, item: url },
    ],
  },
];
---
<Base title={d.titleTag ?? `${d.title} - ${SITE.name}`} description={d.description} ogImage={d.ogImage} ogType="article" schema={schema}>
  <header class="post-head">
    {d.categories.length > 0 && <p class="eyebrow">{d.categories.map((c, i) => <>{i > 0 && ', '}<a href={`/category/${c}/`}>{CATEGORIES[c] ?? c}</a></>)}</p>}
    <h1>{d.title}</h1>
  </header>
  <article class="post-body">
    <div class="narrow">
      <div class="prose"><Content /></div>
      <div class="post-meta">
        <span>{SITE.author}</span>
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        <ul class="share" aria-label="Share this post">
          <li><a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} rel="noopener nofollow" target="_blank">Facebook</a></li>
          <li><a href={`https://twitter.com/intent/tweet?url=${share}&text=${encodeURIComponent(d.title)}`} rel="noopener nofollow" target="_blank">Twitter</a></li>
          <li><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${share}`} rel="noopener nofollow" target="_blank">LinkedIn</a></li>
        </ul>
      </div>
    </div>
  </article>
  <nav class="post-nav" aria-label="Posts">
    {prev && <a href={`/${prev.id}/`} rel="prev">← {prev.data.title}</a>}
    {next && <a href={`/${next.id}/`} rel="next">{next.data.title} →</a>}
  </nav>
  <section class="section band-secondary cta-band">
    <h2>Write Google friendly blog posts in 4 easy steps</h2>
    <p>An SEO checklist for solopreneurs.</p>
    <a class="btn dark" href="/seo-checklist-blog-post-writing/">Download the SEO checklist</a>
  </section>
  <section class="section">
    <h2 class="display">More from the blog</h2>
    <div class="cards four">{more.map((p) => <PostCard post={p} heading="h3" excerpt={false} />)}</div>
  </section>
</Base>
