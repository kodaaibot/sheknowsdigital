---
// Alternative homepage: a like-for-like rebuild of the Lovable "Me Time Away" design.
// Kept out of search (noindex, not in the sitemap) until a decision is made about using it.
import Base from '../layouts/Base.astro';

const retreats = [
  ['6-day-holistic-yoga-retreat-in-san-diego-califronia.webp', 'San Diego, California', '6-Day Holistic Yoga Retreat for Couples', '9 – 14 Mar'],
  ['sage-and-sound-therapy.webp', 'Corsica, France', '3-Day Cleansing & Smudging Rituals', '16 – 18 Mar'],
  ['4-day-couples-fitness-and-weight-loss-retreat.webp', 'Lake Como, Italy', '4-Day Couples Connect & Fitness Retreat', '21 – 24 Sep'],
  ['tuscany-retreats-in-italy.webp', 'Tuscany, Italy', '7-Day Fasting and Yoga Retreat', '2 – 8 Feb'],
  ['madeira-hiking-wellness-retreat.webp', 'Madeira, Portugal', '7-Day Yoga, Hiking & Nature Retreat', '13 – 19 May'],
  ['wine-tasting-and-rejuvenation-retreat-for-couples-monopoli-italy.webp', 'Monopoli, Italy', '6-Day Wine Tasting & Rejuvenation', '16 – 21 Aug'],
  ['beach-yoga-retreats-in-st-ives-uk.webp', 'St. Ives, United Kingdom', '3-Day Beach Yoga & Meditation', '12 – 14 Mar'],
  ['10-day-luxury-yoga-calming-retreat-with-reiki-and-sound-healing-bali-indonesia.webp', 'Ubud, Bali', '10-Day Luxury Calming Yoga with Reiki', '11 – 20 Jan'],
  ['reset-recharge-women-retreats-in-zakhyntos.webp', 'Zakynthos, Greece', '7-Day Reset & Recharge Women Retreat', '21 – 27 Jun'],
];
// The Lovable design links each type to /retreats/<type>. Those pages are not built here yet.
const types = ['Cold Therapy', 'Detox', 'Mindfulness', 'Meditation', 'Sound Bath', 'Eco-Friendly', 'Yoga', 'Marriage'];
---
<Base title="Me Time Away — Wellbeing Through Conscious Travel" description="Discover premium, sustainable wellbeing retreats in the world's most beautiful places." noindex bare>
  <div class="mta">
    <header class="mta-header">
      <span class="mta-logo">me time away</span>
      <nav aria-label="Sections">
        <a href="#retreats">Retreats</a>
        <a href="#types">Types</a>
        <a href="#about">About</a>
        <a href="#join">Join</a>
      </nav>
    </header>

    <section class="mta-hero">
      <img src="/images/home-alt/hero.jpg" alt="Woman meditating at sunrise above the sea" width="1920" height="1088" fetchpriority="high" />
      <div class="shade"></div>
      <div class="copy">
        <p class="kicker">Wellbeing through conscious travel</p>
        <h1>To travel is to take a journey into yourself.</h1>
        <a class="cta" href="#retreats">Explore retreats</a>
      </div>
    </section>

    <section class="mta-strip">
      <span>Sustainable travel retreats</span>
      <span>Unique wellbeing experiences</span>
      <span>Hidden gems in stunning places</span>
    </section>

    <section id="retreats" class="mta-section">
      <div class="head">
        <h2>Featured retreats</h2>
        <p>Group getaways and individual therapies, hand-picked for their care for people and planet.</p>
      </div>
      <div class="grid">
        {retreats.map(([img, place, name, dates]) => (
          <article class="retreat">
            <div class="photo"><img src={`/images/retreats/${img}`} alt={name} width="400" height="400" loading="lazy" /></div>
            <p class="place">{place}</p>
            <h3>{name}</h3>
            <p class="dates">{dates}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="about" class="mta-about">
      <div>
        <h2>What is Me Time Away?</h2>
        <p>The first premium wellbeing retreat booking platform with sustainable travel woven into its founding values. We partner only with hosts who put the natural environment at the heart of what they offer — beautiful destinations, sustainable stays, nourishing meals and experienced healers.</p>
      </div>
    </section>

    <section id="types" class="mta-section">
      <h2 class="types-title">Find your kind of stillness</h2>
      <div class="types">
        {types.map((t) => <div class="type">{t}<span>Retreats →</span></div>)}
      </div>
    </section>

    <section id="join" class="mta-join">
      <div>
        <h2>Join the journey</h2>
        <p>Retreat news and hidden gems, a few times a season.</p>
        <form name="join" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="join" />
          <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <input type="text" name="name" placeholder="Name" aria-label="Name" required />
          <input type="email" name="email" placeholder="Email" aria-label="Email" required />
          <select name="role" aria-label="I am a">
            <option>I am a traveller</option>
            <option>I am a host</option>
          </select>
          <label class="agree"><input type="checkbox" name="consent" value="yes" required /> I agree to receive newsletters and accept the privacy statement.</label>
          <button type="submit">Send</button>
        </form>
      </div>
    </section>

    <footer class="mta-footer">© {new Date().getFullYear()} Me Time Away</footer>
  </div>
</Base>

<style>
  .mta {
    --background: oklch(97% 0.015 85);
    --foreground: oklch(25% 0.03 150);
    --card: oklch(99% 0.008 85);
    --primary: oklch(38% 0.06 150);
    --primary-foreground: oklch(97% 0.015 85);
    --secondary: oklch(92% 0.03 80);
    --muted: oklch(93% 0.02 85);
    --muted-foreground: oklch(48% 0.03 150);
    --accent: oklch(68% 0.11 50);
    --accent-foreground: oklch(99% 0.008 85);
    --border: oklch(86% 0.025 85);
    --overlay: oklch(20% 0.03 150 / 0.55);
    --x: 24px;
    background: var(--background);
    color: var(--foreground);
    font: 400 16px/1.5 'Karla', sans-serif;
    position: relative;
  }
  .mta h1, .mta h2, .mta h3 { font-family: 'Cormorant Garamond', serif; font-weight: 500; margin: 0; }
  .mta p { margin: 0; }
  .mta a { color: inherit; }
  .mta a:hover { text-decoration: none; }

  .mta-header { position: absolute; inset: 0 0 auto 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 24px var(--x); color: var(--primary-foreground); }
  .mta-logo { font: italic 400 24px/32px 'Cormorant Garamond', serif; }
  .mta-header nav { display: none; gap: 32px; font-size: 14px; line-height: 20px; letter-spacing: 0.025em; }

  .mta-hero { position: relative; display: flex; align-items: flex-end; min-height: 92vh; }
  .mta-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .mta-hero .shade { position: absolute; inset: 0; background: linear-gradient(to top, var(--overlay), transparent); }
  .mta-hero .copy { position: relative; max-width: 48rem; padding: 0 var(--x) 80px; color: var(--primary-foreground); }
  .kicker { font-size: 12px; line-height: 16px; text-transform: uppercase; letter-spacing: 0.3em; margin-bottom: 16px !important; }
  .mta-hero h1 { font-size: 48px; line-height: 1.25; }
  .cta { display: inline-block; margin-top: 32px; border-radius: 4px; background: var(--accent); color: var(--accent-foreground) !important; padding: 12px 28px; font-size: 14px; line-height: 20px; font-weight: 500; transition: opacity 0.15s; }
  .cta:hover { opacity: 0.9; }

  .mta-strip { display: grid; gap: 24px; border-bottom: 1px solid var(--border); padding: 40px var(--x); text-align: center; font-size: 14px; line-height: 20px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--muted-foreground); }

  .mta-section { padding: 96px var(--x); }
  .mta-section .head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 48px; }
  .mta-section h2, .mta-about h2, .mta-join h2 { font-size: 36px; line-height: 40px; }
  .mta-section .head p { max-width: 24rem; color: var(--muted-foreground); }
  .grid { display: grid; gap: 32px; }
  .photo { position: relative; overflow: hidden; border-radius: 4px; background: var(--muted); }
  .photo img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; filter: sepia(0.22) saturate(0.8) contrast(0.95) brightness(1.03); transition: filter 0.7s, transform 0.7s; }
  .photo::after { content: ''; pointer-events: none; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, color-mix(in oklab, var(--primary) 25%, transparent)); mix-blend-mode: multiply; box-shadow: inset 0 0 0 9999px color-mix(in oklab, var(--accent) 8%, transparent); }
  .retreat:hover .photo img { transform: scale(1.05); filter: sepia(0.1) saturate(0.95) contrast(1) brightness(1.03); }
  .place { margin-top: 16px !important; font-size: 12px; line-height: 16px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent); }
  .retreat h3 { margin-top: 4px; font-size: 24px; line-height: 32px; }
  .dates { font-size: 14px; line-height: 20px; color: var(--muted-foreground); }

  .mta-about { background: var(--primary); color: var(--primary-foreground); padding: 96px var(--x); }
  .mta-about div { max-width: 48rem; margin: 0 auto; text-align: center; }
  .mta-about p { margin-top: 24px; font-size: 18px; line-height: 1.625; opacity: 0.9; }

  .types-title { margin-bottom: 40px !important; }
  .types { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; overflow: hidden; border: 1px solid var(--border); border-radius: 4px; background: var(--border); }
  .type { background: var(--card); padding: 32px; font: 500 24px/32px 'Cormorant Garamond', serif; transition: background 0.15s; }
  .type:hover { background: var(--secondary); }
  .type span { display: block; font: 400 12px/16px 'Karla', sans-serif; text-transform: uppercase; letter-spacing: 0.2em; color: var(--muted-foreground); }

  .mta-join { background: var(--secondary); padding: 96px var(--x); }
  .mta-join > div { max-width: 36rem; margin: 0 auto; text-align: center; }
  .mta-join > div > p { margin-top: 16px; color: var(--muted-foreground); }
  .mta-join form { display: grid; gap: 12px; margin-top: 32px; text-align: left; }
  .mta-join input[type='text'], .mta-join input[type='email'], .mta-join select { font: inherit; color: inherit; border: 1px solid var(--border); border-radius: 4px; background: var(--card); padding: 12px 16px; width: 100%; }
  .agree { display: flex; gap: 8px; align-items: center; font-size: 14px; line-height: 20px; color: var(--muted-foreground); }
  .mta-join button { margin-top: 8px; border: 0; border-radius: 4px; background: var(--primary); color: var(--primary-foreground); padding: 12px 0; font: 500 16px/24px 'Karla', sans-serif; cursor: pointer; }
  .mta-join button:hover { opacity: 0.9; }
  .hp { position: absolute; left: -9999px; }

  .mta-footer { padding: 40px var(--x); text-align: center; font-size: 14px; line-height: 20px; color: var(--muted-foreground); }

  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 768px) {
    .mta { --x: 48px; }
    .mta-header nav { display: flex; }
    .mta-hero h1 { font-size: 72px; }
    .mta-strip { grid-template-columns: repeat(3, 1fr); }
    .mta-section h2, .mta-about h2, .mta-join h2 { font-size: 48px; line-height: 1; }
    .types { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(4, 1fr); } }
</style>
