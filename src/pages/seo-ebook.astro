---
// SEO ebook landing page. Redesigned Nov 2026. Not linked from the footer or menu (Mags' request); reachable from old posts.
// Title tag and meta description are unchanged from WordPress (src/data/page-meta.json).
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import { SITE } from '../lib/site';
import meta from '../data/page-meta.json';
const m = meta['/seo-ebook/'];
---
<Base title={m.title} description={m.description} crumb="SEO eBook" ogImage={`${SITE.url}/images/ebook/seo-ebook-cover.jpg`}>
  <Landing kicker="Free guide · Four steps" formName="seo-ebook" button="Send me the free guide" closingCta="Get the free guide"
    lead="An easy-to-follow SEO guide for solopreneurs. Use the same four steps every time you publish, and give each post a real chance of being found."
    cover="/images/ebook/seo-ebook-cover.webp" coverAlt="Cover of the free guide: How to write blog posts that Google and readers will love, a four-step SEO checklist by Mags Sikora">
    <Fragment slot="heading">Write <span class="nowrap">Google‑friendly</span> blog <em>posts</em>.</Fragment>
  </Landing>
</Base>
