---
import Base from '../layouts/Base.astro';
import { SERVICES } from '../lib/site';
---
<Base title="Book a Consultation — sheknowsdigital" description="Enquire about technical audits, migrations or SEO advisory with Mags Sikora.">
  <section class="intro-head">
    <p class="kicker">Enquiries</p>
    <h1>Let's plan your <em>route</em>.</h1>
    <p class="lead">Share a little about your site and goals. I reply within two working days — usually sooner, unless I'm on a summit.</p>
  </section>
  <div class="w-3xl">
    <form class="grid-2" style="gap:20px" name="contact" method="POST" data-netlify="true" data-netlify-recaptcha="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact" />
      <p class="hp" style="position:absolute;left:-9999px"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <label class="field">Name<input type="text" name="name" autocomplete="name" required /></label>
      <label class="field">Work email<input type="email" name="email" autocomplete="email" required /></label>
      <label class="field">Company &amp; website<input type="text" name="company" autocomplete="organization" /></label>
      <label class="field">Area of interest
        <select name="interest">{SERVICES.map(([name]) => <option>{name}</option>)}</select>
      </label>
      <label class="field span-2">Preferred timing
        <select name="timing">
          <option>Exploratory call this month</option>
          <option>Project starting next quarter</option>
          <option>Urgent — migration or traffic drop</option>
        </select>
      </label>
      <label class="field span-2">Tell me about the terrain<textarea name="message" rows="5" required></textarea></label>
      <div class="captcha span-2" data-netlify-recaptcha="true"></div>
      <button class="pill-primary" type="submit">Send enquiry</button>
      <p class="form-note span-2" role="status" hidden></p>
    </form>
  </div>
  <script>
    // Submit in place and show a confirmation. Without JavaScript the form still posts normally.
    const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
    const note = form?.querySelector<HTMLElement>('.form-note');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const body = new URLSearchParams(new FormData(form) as any).toString();
      try {
        const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        (window as any).grecaptcha?.reset();
        note!.textContent = 'Thank you. Your enquiry has been sent.';
      } catch {
        note!.textContent = 'The enquiry could not be sent. Please tick the “I’m not a robot” box and try again.';
      }
      note!.hidden = false;
    });
  </script>
</Base>
