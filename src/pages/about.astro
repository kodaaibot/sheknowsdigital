---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
import { person, PERSON_ID } from '../lib/schema';

const title = 'About Mags Sikora — sheknowsdigital';
const description = '18+ years of enterprise eCommerce SEO. Nature lover, gardener, mountain hiker and cat person.';
// Same pattern as magstags.com/mags-sikora/: Person + BreadcrumbList + ProfilePage, all pointing at the one Person @id.
const page = {
  '@type': 'ProfilePage',
  about: { '@id': PERSON_ID },
  mainEntity: { '@id': PERSON_ID },
  primaryImageOfPage: `${SITE.url}/images/home/mags-sikora-about.webp`,
};
// Career trail: copy supplied by Mags (Nov 2026).
const trail = [
  ['Intrepid Digital', 'As SEO Director, I’ve worked with clients including SKIMS, Skyscanner, Good American and Allbirds.'],
  ['Emirates Group', 'I led SEO across five brands and 40+ markets. At Emirates Holidays, non-brand organic traffic grew 101% in year two and a further 140% in year three.'],
  ['Expedia Group', 'I managed SEO for the UK and Ireland, then returned to lead SEO strategy for an Expedia brand across 15 countries and 12 languages.'],
  ['New Look', 'I led SEO for the fashion retailer’s site migration. Non-brand organic traffic for high-volume search terms rose 10% the following quarter.'],
];
const traits = [
  ['Mountains', 'Long ridges teach patience and planning. So do migrations.'],
  ['The garden', 'What you plant this spring feeds you in three summers.'],
  ['Cats', 'Independent, curious, and suspicious of anything too shiny.'],
  ['Nature', 'Ecosystems over hacks. Everything is connected.'],
];
---
<Base title={title} description={description} crumb="About" page={page} schema={[person]}>
  <section class="intro-head">
    <p class="kicker">About</p>
    <h1>Hi, I'm Mags. I've been <em>tending search</em> for 18 years.</h1>
    <p class="lead">I'm a senior eCommerce SEO consultant who has worked inside and alongside some of the largest digital brands in travel, fashion and retail. Off-screen you'll find me on a mountain trail, elbow-deep in soil, or negotiating desk space with my cat.</p>
  </section>
  <section class="w-4xl grid-2" style="gap:40px;align-items:start">
    <figure style="margin:0">
      <img src="/images/home/mags-sikora-about.webp" alt="Portrait of Mags Sikora, eCommerce SEO consultant" width="640" height="640" style="width:100%;aspect-ratio:1;object-fit:cover;border-radius:8px" />
      <figcaption style="margin-top:12px;font-size:14px;color:var(--muted)">Mags Sikora · sheknowsdigital</figcaption>
    </figure>
    <div>
      <h2 style="font-size:30px;line-height:36px;margin:0">The trail so far</h2>
      <ol class="timeline">
        {trail.map(([name, text]) => <li><h3>{name}</h3><p>{text}</p></li>)}
      </ol>
    </div>
  </section>
  <section class="w-6xl grid-4" style="margin-top:64px">
    {traits.map(([name, text]) => <div class="trait"><h3>{name}</h3><p>{text}</p></div>)}
  </section>
  {/* The original About page story from the WordPress site, kept so the page loses no content. Not part of the Lovable design. */}
  <section class="w-3xl prose" style="margin-top:96px">
    <h2>How it started</h2>
    <p><strong>This is the story of the best investment of my life.</strong></p>
    <p>I arrived in London in August 2003 after a 48-hour bus journey. I came to London on my own. I didn’t know anyone here. I was 22.</p>
    <p>With 60 GBP in my pocket (thinking it’s a lot!), I wanted to learn how to speak English.</p>
    <p>I found myself without a job but I had my laptop with me, so every night, before going to bed, I learned the language and…</p>
    <p>how to build a website – something I always wanted to do, being an internet enthusiast.</p>
    <p>It took me some time, but one day, I did it! I created a simple HTML website!</p>
    <p>It was also the time when my English started getting better and I even had a small office job too.</p>
    <p>I quickly noticed that I couldn’t find my website anywhere on Google and that’s how I found out about search engine optimisation (SEO).</p>
    <p>I became intrigued…</p>
    <p>I ordered a book to learn more about SEO, and read the book back to back twice to make sure I do not miss a single thing.</p>
    <p>I read every single article that came out online (bare in mind that SEO was simplier those days:)</p>
    <p>I followed the advice to a tee, making plenty of notes as I went and, in the end, I had a fully optimised website.</p>
    <p>A few weeks later the website started ranking in Google for highly searchable terms.</p>
    <p>Most importantly, I LOVED EVERY SINGLE MINUTE OF THE PROCESS OF GETTING THERE.</p>
    <p>From that moment, I knew exactly what I wanted.</p>
    <p>I wanted to optimise websites towards search engines.</p>
    <p>So I went to job interviews (took the book and my notes with me) and I got my first agency side position!</p>
    <p>12 years later.</p>
    <p>I am pleased to say that I have worked with the best global brands- Avis, Hotels.com, TripAdvisor- to name a few.</p>
    <p>I have also managed SEO for Expedia then became Digital Marketing Manager at NewLook.com, one of the biggest fashion retailers in the UK; then become Group SEO Director at dnata Emirates Group where I was responsible for designing strategy across 6 brands, 54 markets, to finally set up my own digital marketing business in London.</p>
    <p>As Ben Franklin said,</p>
    <p><em>an investment in knowledge always pays the best interest</em></p>
    <p>Learning SEO appears to be the best investment I have done in my life.</p>
    <p>… and I know it can be yours too!</p>
    <p>You can find me on <a href="https://www.linkedin.com/in/magdalenasikora/">LinkedIn</a> | <a href="https://www.youtube.com/c/Sheknowsdigital">YouTube</a> | <a href="https://www.facebook.com/sheknowsdigital">Facebook</a> | <a href="https://www.magstags.com/">Magstags</a> |<br />Please also see my latest project: <a href="https://www.sendlikeapro.com/">Send Like A Pro!</a></p>
  </section>
</Base>
