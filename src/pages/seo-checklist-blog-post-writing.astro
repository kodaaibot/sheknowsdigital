---
// SEO checklist landing page. Redesigned Nov 2026 to match the site; title tag and meta description in src/data/page-meta.json.
// Signups require a name and newsletter consent (as on WordPress) and land on /thank-you/.
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import { SITE } from '../lib/site';
import meta from '../data/page-meta.json';
const m = meta['/seo-checklist-blog-post-writing/'];
---
<Base title={m.title} description={m.description} crumb="SEO Checklist" ogImage={`${SITE.url}/images/ebook/seo-checklist-cover.jpg`}>
  <Landing kicker="Free checklist · Four steps" formName="seo-checklist" button="Send me the checklist" closingCta="Get the free checklist" strict kind="sheet"
    lead="Attract new readers with every post you write. Four steps to work through each time you publish, so both Google and your readers get what they came for."
    cover="/images/ebook/seo-checklist-cover.webp" coverAlt="The free SEO checklist: tick boxes for planning, writing, optimising and promoting a blog post, by Mags Sikora">
    <Fragment slot="heading">Your SEO <em>checklist</em>.</Fragment>
  </Landing>
</Base>
